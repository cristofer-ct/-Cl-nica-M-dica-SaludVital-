<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.cg.system.main.controller.MainController" prefWidth="800" prefHeight="500">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Clínica Médica SaludVital - Pacientes" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Recargar" onAction="#cargar"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tblPacientes">
            <columns>
                <TableColumn fx:id="colDpi" text="DPI" prefWidth="140"/>
                <TableColumn fx:id="colNombres" text="Nombres" prefWidth="200"/>
                <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="200"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="lblEstado" text="..."><padding><Insets top="6" right="12" bottom="6" left="12"/></padding></Label>
    </bottom>
</BorderPane>
